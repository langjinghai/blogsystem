# 本地开发配置示例
# 复制为 blogSystem/application-local.yaml（已被 .gitignore 忽略），再填入真实值
spring:
  datasource:
    username: root
    password: change-me
  redis:
    host: 127.0.0.1
    port: 6379
  # QQ 邮箱 SMTP（可选；不配则邮箱验证码接口会提示“邮件服务未配置”）
  mail:
    host: smtp.qq.com
    port: 465
    username: your-qq-number@qq.com
    password: change-me-qq-auth-code
