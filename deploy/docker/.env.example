# 复制为 deploy/docker/.env 后填写，切勿提交真实密钥
# 密码含 # 或空格时，请用双引号包起来
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_USER=bloguser
MYSQL_PASSWORD=change-me-db

OSS_ACCESS_KEY_ID=change-me
OSS_ACCESS_KEY_SECRET=change-me

# 可选：默认值见 application-docker.yaml
# OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
# OSS_BUCKET=blogsystems

# 可选：国内构建前端时可改为 https://registry.npmmirror.com
# NPM_REGISTRY=https://registry.npmjs.org
