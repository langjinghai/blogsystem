# ============================================================
#  systemd 环境变量文件
#  复制到服务器：/opt/blogsystem/blog.env
#  权限：chmod 600 /opt/blogsystem/blog.env
# ============================================================

TZ=Asia/Shanghai
SPRING_PROFILES_ACTIVE=prod

# 阿里云 OSS 访问密钥（必填，否则应用启动时占位符无法解析）
OSS_ACCESS_KEY_ID=CHANGE_ME
OSS_ACCESS_KEY_SECRET=CHANGE_ME

# QQ 邮箱 SMTP（邮箱登录/注册/找回密码）
# MAIL_PASSWORD 是 QQ 邮箱授权码，不是 QQ 登录密码
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=your-qq-number@qq.com
MAIL_PASSWORD=CHANGE_ME_QQ_AUTH_CODE
# 可选：发件人，默认等于 MAIL_USERNAME
# MAIL_FROM=your-qq-number@qq.com

# 如密钥包含 # 或空格，请使用双引号包起来，例如：
# OSS_ACCESS_KEY_SECRET="abc#123"
