# ============================================================
#  生产环境配置示例
#  复制到服务器：/opt/blogsystem/application-prod.yaml
#  启动时通过 SPRING_PROFILES_ACTIVE=prod 自动加载
# ============================================================

server:
  port: 8080
  # 只监听本机，由 nginx 反向代理；避免 8080 直接暴露
  address: 127.0.0.1

spring:
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://127.0.0.1:3306/blogsystem?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useUnicode=true&characterEncoding=UTF-8
    username: bloguser
    password: "CHANGE_ME"

  redis:
    host: 127.0.0.1
    port: 6379
    database: 0
    # 如果 Redis 设置了密码，取消下一行注释
    # password: "CHANGE_ME"
    lettuce:
      pool:
        max-active: 10
        max-idle: 10
        min-idle: 1
        time-between-eviction-runs: 10s

  servlet:
    multipart:
      max-file-size: 5MB
      max-request-size: 10MB

# 阿里云 OSS（图片上传）
# access-key-id / secret 从 systemd 的 /opt/blogsystem/blog.env 读取
aliyun:
  oss:
    endpoint: oss-cn-shenzhen.aliyuncs.com
    access-key-id: ${OSS_ACCESS_KEY_ID}
    access-key-secret: ${OSS_ACCESS_KEY_SECRET}
    bucket-name: blogsystems

# 生产环境降低日志量，关闭 MyBatis SQL 控制台输出
logging:
  level:
    com.example.springbootproject: info

mybatis-plus:
  configuration:
    log-impl: org.apache.ibatis.logging.nologging.NoLoggingImpl
